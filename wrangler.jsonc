// Cloudflare deploy settings. The build makes dist/ and Cloudflare serves it as plain files.
// The only code that runs on Cloudflare is the small helper in worker/ (it answers /api/* and
// sends the phone its buzzes). The name must match the project name in the Cloudflare dashboard.
{
  "name": "bird-nest",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any unknown path opens the app (it's a single-page app)...
    "not_found_handling": "single-page-application",
    // ...except /api/*, which goes to the helper.
    "run_worker_first": ["/api/*"]
  },
  // One small Notifier per phone: its push address and the buzzes waiting to go out.
  "durable_objects": {
    "bindings": [{ "name": "NOTIFIER", "class_name": "Notifier" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Notifier"] }],
  "vars": {
    // Public half of the push key (safe to share). The private half is the VAPID_PRIVATE *secret*
    // (Type: Secret, not Variable), set once in the Cloudflare dashboard and never in this file.
    // Without it, buzzing just says "not set up yet". (Key replaced Oct 28: the first private key was shown as a plain variable.)
    "VAPID_PUBLIC": "BHATYj-o0ufRsu9UCBjyDe75zHUXxeczATN3IskSjsRDuXzBc4HW1rY65YKnDN3k0POCzDKCdBUd-6QYf24c75c",
    "VAPID_SUBJECT": "https://bird-nest.tonyc-bird.workers.dev"
  }
}
